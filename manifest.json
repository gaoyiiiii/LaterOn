{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.65.0",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "121",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "tabs",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "__MSG_commandSavePage__"
    },
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "__MSG_commandTranslatePage__"
    },
    "save-all-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "__MSG_commandSaveAllTabs__"
    }
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon128.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
